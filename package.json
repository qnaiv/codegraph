{
  "name": "codegraph",
  "displayName": "CodeGraph – Salesforce Apex Visualizer",
  "description": "Mind-map style visualization of Salesforce Apex classes and SObject relationships",
  "version": "0.0.1",
  "publisher": "qnaiv",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.cls",
    "workspaceContains:**/*.trigger"
  ],
  "main": "./out/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codegraph.open",
        "title": "CodeGraph: Open"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "tsc -p tsconfig.json",
    "build:webview": "vite build",
    "watch:extension": "tsc -p tsconfig.json --watch",
    "watch:webview": "vite",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@xyflow/react": "^12.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "zustand": "^4.5.5"
  },
  "dependencies": {
    "@apexdevtools/apex-parser": "^5.0.0",
    "fast-xml-parser": "^5.8.0"
  }
}
