<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Order Item</label>
    <pluralLabel>Order Items</pluralLabel>
    <nameField>
        <label>Order Item Name</label>
        <type>AutoNumber</type>
        <displayFormat>ITEM-{0000}</displayFormat>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ControlledByParent</sharingModel>

    <fields>
        <fullName>Order__c</fullName>
        <label>Order</label>
        <type>MasterDetail</type>
        <referenceTo>Order__c</referenceTo>
        <relationshipName>OrderItems</relationshipName>
        <relationshipLabel>Order Items</relationshipLabel>
        <required>true</required>
    </fields>

    <fields>
        <fullName>ProductName__c</fullName>
        <label>Product Name</label>
        <type>Text</type>
        <length>255</length>
        <required>true</required>
    </fields>

    <fields>
        <fullName>Quantity__c</fullName>
        <label>Quantity</label>
        <type>Number</type>
        <precision>18</precision>
        <scale>0</scale>
        <required>true</required>
    </fields>

    <fields>
        <fullName>UnitPrice__c</fullName>
        <label>Unit Price</label>
        <type>Currency</type>
        <precision>18</precision>
        <scale>2</scale>
        <required>true</required>
    </fields>
</CustomObject>
